# Frontend — uniquement la clé publique VAPID
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# Frontend — URL du backend ScoreMatch, jamais le fournisseur sportif directement
VITE_API_BASE_URL=http://localhost:4310
# Identifiant API-Football de l’équipe favorite pour les transferts (ex. PSG = 85)
VITE_TRANSFER_TEAM_ID=85

# Backend — ne jamais exposer ces variables dans le bundle frontend
PORT=4310
APP_ORIGIN=http://localhost:5173
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:notifications@example.com
# Choisir : sportmonks, api-football ou football-data
SCORES_PROVIDER=api-football
SPORTS_API_PROVIDER=sportmonks
SPORTS_API_TOKEN=replace_with_server_side_token
API_FOOTBALL_KEY=replace_with_api_football_key
# Le forfait gratuit testé autorise actuellement les saisons 2022 à 2024.
API_FOOTBALL_SEASON=2024
# Cache backend partagé, obligatoire en production multi-instance
REDIS_URL=redis://localhost:6379
CACHE_SCORES_LIVE_SECONDS=30
CACHE_SCORES_DAY_SECONDS=300
CACHE_TRANSFERS_SECONDS=1800
CACHE_TEAMS_SECONDS=86400
CACHE_PLAYERS_SECONDS=3600
# Protection HTTP : 120 requêtes par minute et par adresse par défaut
RATE_LIMIT_MAX=120
FOOTBALL_DATA_TOKEN=replace_with_football_data_token
